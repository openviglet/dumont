---
// Under 50rem the header nav is hidden, so the menu Starlight opens there carries the
// site's links instead, above its own theme and language pickers.
import Default from "@astrojs/starlight/components/MobileMenuFooter.astro";
import { NAV_AEM, NAV_GROUPS } from "../../../src/lib/site-links";
---

<nav class="site-nav-mobile" aria-label="Viglet Dumont">
  <a href={NAV_AEM.href}>{NAV_AEM.label}</a>
  {
    NAV_GROUPS.map((group) => (
      <div>
        <p>{group.label}</p>
        {group.items.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
    ))
  }
</nav>
<Default />
