---
// A card that links to a page of this area. `href` is relative to the area's root
// ("connectors/aem/"), and the base is added here: Astro rewrites the links it generates
// and not ones typed into a page, so a hand-written "/connectors/aem/" would 404 under /docs.
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  eyebrow?: string;
}
const { title, description, href, icon, eyebrow } = Astro.props;
const external = /^[a-z]+:/i.test(href);
const to = external ? href : import.meta.env.BASE_URL.replace(/\/?$/, "/") + href.replace(/^\//, "");
---

<a class="dm-card dm-card-link not-content" href={to}>
  {icon && <span class="dm-card-icon" aria-hidden="true">{icon}</span>}
  <span>
    {eyebrow && <span class="dm-card-eyebrow">{eyebrow}</span>}
    <span class="dm-card-title">{title}</span>
    <span class="dm-card-body">{description}</span>
  </span>
</a>
