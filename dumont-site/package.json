{
  "name": "dumont-site",
  "private": true,
  "version": "2026.3.1",
  "type": "module",
  "description": "Public site of Viglet Dumont DEP (dumont.viglet.org), the open-source connector platform that moves content from AEM, databases, files and the web into Turing ES, Solr or Elasticsearch.",
  "homepage": "https://dumont.viglet.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openviglet/dumont.git",
    "directory": "dumont-site"
  },
  "bugs": {
    "url": "https://github.com/openviglet/dumont/issues"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/og-image.mjs && pnpm run build:docs && node scripts/docs-twins.mjs",
    "build:docs": "pnpm --dir docs run build",
    "dev:docs": "pnpm --dir docs run dev",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "marked": "^18.1.1",
    "node-html-parser": "^9.0.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2"
  },
  "keywords": [
    "dumont",
    "viglet",
    "connector",
    "indexing",
    "enterprise-search",
    "aem",
    "solr",
    "elasticsearch",
    "turing",
    "web-crawler",
    "etl"
  ],
  "author": {
    "name": "Viglet Team",
    "url": "https://www.viglet.org"
  }
}
