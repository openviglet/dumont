# syntax=docker/dockerfile:1.7
# Runtime-only image for LOCAL publishing (publish-docker.cmd).
#
# Unlike the root Dockerfile (which runs Maven INSIDE the container), this one
# copies jars you already built on the host with `mvnw package`. That sidesteps
# the private viglet-core GitHub Packages 401 (the host ~/.m2 is already
# authenticated) and guarantees the image contains your local working-tree
# changes. Mirrors the runtime stage of the root Dockerfile exactly.
FROM eclipse-temurin:25-jre
ARG CACHE_BUST=none
LABEL org.opencontainers.image.revision=$CACHE_BUST
RUN groupadd -r java && useradd -r -g java -u 1001 java
WORKDIR /app
COPY connector/connector-app/target/dumont-connector.jar app.jar
# Bundle every connector plugin (AEM, EDS, DB, Web Crawler, Assets) so a single
# image supports all connector types at once. Added to the classpath at startup
# via Spring Boot's PropertiesLauncher `loader.path`.
COPY aem/aem-plugin/target/aem-plugin.jar /app/libs/aem-plugin.jar
COPY eds/eds-plugin/target/eds-plugin.jar /app/libs/eds-plugin.jar
COPY db/db-plugin/target/db-plugin.jar /app/libs/db-plugin.jar
COPY web-crawler/wc-plugin/target/web-crawler-plugin.jar /app/libs/web-crawler-plugin.jar
COPY assets/assets-plugin/target/assets-plugin.jar /app/libs/assets-plugin.jar
RUN mkdir -p /app/store && chown -R java:java /app
USER java
VOLUME ["/app/store"]
EXPOSE 30130
ENV JAVA_OPTS="-Xmx512m -Xms512m"
ENV DEBUG_OPTS=""
# LOADER_PATH points PropertiesLauncher at the bundled connector plugins.
ENV LOADER_PATH="/app/libs"
ENTRYPOINT ["sh", "-c", "exec java ${JAVA_OPTS} ${DEBUG_OPTS} -Djava.security.egd=file:/dev/./urandom -Dloader.path=${LOADER_PATH} -Dlogging.config=classpath:logback-spring-console.xml -jar /app/app.jar"]
