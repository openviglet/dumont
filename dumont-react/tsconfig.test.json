{
  /*
   * D42 — the suite is its own project because it is the only code here that is neither the
   * browser app nor the build config. It renders app modules, so it needs the `@/` paths and
   * the JSX settings; it also reads the filesystem to hold the census, so it needs Node's
   * types — which `tsconfig.app.json` deliberately does not carry, the app having no `fs`.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `node` for the census reader's `fs`/`path`, `vite/client` because a test that renders a
    // page pulls in src modules that read `import.meta.env`.
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["test"]
}
