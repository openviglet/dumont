{
  // SonarLint integration
  "sonarlint.connectedMode.project": {
    "connectionId": "viglet",
    "projectKey": "viglet_dumont"
  },

  // Java Language Server memory tuning
  "java.jdt.ls.vmargs": "-Xms4096m -Xmx8192m -XX:+UseG1GC -XX:+UseStringDeduplication",
  "java.format.settings.url": "./eclipse-java-style.xml",
  "java.format.settings.profile": "GoogleStyle",
  // Disable automatic builds to reduce CPU usage
  "java.autobuild.enabled": false,

  // Improve editor responsiveness and clarity
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },

  // Optional: Hide clutter in file explorer
  "files.exclude": {
    "**/target": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true
  },

  // Postman extension tweak
  "postman.settings.dotenv-detection-notification-visibility": false,
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.compile.nullAnalysis.mode": "automatic",
  "window.title": "✈️ Dumont ${separator} ${dirty}${activeEditorShort} ${separator} ${appName}",

  // Status bar in the Dumont logo green so this worktree is easy to spot
  "workbench.colorCustomizations": {
    "statusBar.background": "#0f766e",
    "statusBar.foreground": "#ccfbf1",
    "statusBar.border": "#115e59",
    "statusBar.noFolderBackground": "#0f766e",
    "statusBar.debuggingBackground": "#0f766e",
    "statusBarItem.hoverBackground": "#115e59",
    "statusBarItem.remoteBackground": "#115e59",
    "statusBarItem.remoteForeground": "#ccfbf1"
  }
}
