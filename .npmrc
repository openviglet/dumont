# pnpm settings for the Dumont frontend workspace.

# Hoist every transitive dep to the top-level node_modules so code that relies
# on phantom imports (e.g. @module-federation/runtime via the Vite plugin) keeps
# working. Loses pnpm's strictness but preserves the main benefit of the move:
# correct resolution of platform-specific optional natives (@tailwindcss/oxide
# on Linux CI, esbuild/rolldown binaries, etc.).
shamefully-hoist=true

# CI/builds should never block on a missing engines entry. Keep 'engines'
# advisory only.
engine-strict=false
